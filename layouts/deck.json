{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-plus"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-plus"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-plus"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-plus",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 58
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-plus"
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "field",
          "type": "block",
          "content": {
            "mod": "field"
          },
          "size": {
            "px": 230
          },
          "min": 120,
          "max": 520,
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 2
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-plus"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 2,
                  "gap": 6,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "pr",
                      "type": "block",
                      "content": {
                        "mod": "pr-files"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 6,
          "gap": 6
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status-plus"
          },
          "size": {
            "px": 24
          }
        }
      ],
      "gap": 6,
      "resizable": false
    },
    {
      "id": "inbox",
      "type": "block",
      "content": {
        "mod": "inbox"
      },
      "size": {
        "px": 340
      },
      "min": 240,
      "max": 560,
      "background": "chrome"
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "deck",
  "ui_font": "JetBrains Mono",
  "cloned_from": {
    "name": "field",
    "version": "0.1.12"
  },
  "preview": "layouts/deck.svg"
}